# Copy this file to terraform.tfvars and fill in your values
# cp terraform.tfvars.example terraform.tfvars

project_id   = "my-gcp-project-id"
region       = "us-central1"
zone         = "us-central1-a"
cluster_name = "nemo-rl"

# GPU configuration
gpu_type         = "nvidia-a100-80gb"
gpus_per_node    = 8
gpu_machine_type = "a2-ultragpu-8g"
max_gpu_nodes    = 4
use_spot         = true

# Storage
filestore_capacity_gb = 1024
# gcs_checkpoint_bucket = ""  # Leave empty for auto-generated name
